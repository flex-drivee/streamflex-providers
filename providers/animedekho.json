{
  "$schema": "https://streamflex.dev/schemas/provider/v1.json",
  "schemaVersion": 1,
  "providerVersion": 1,
  "minimumEngineVersion": "1.0.0",

  "id": "animedekho",
  "name": "AnimeDekho",
  "description": "Hindi dubbed and subbed anime provider. Sources served through multiple video hosts (AbyssPlayer, Vidmoly, StreamRuby, GDMirrorBot, Cloudy, TurboVid, StreamUp).",
  "language": "hi",
  "region": "IN",

  "lifecycle": "stable",
  "status": "online",

  "domains": {
    "primary": "https://animedekho.app",
    "mirrors": [
      "https://hindisubanime.co"
    ],
    "updatedAt": "2026-08-20"
  },

  "capabilities": {
    "supportsSearch": true,
    "supportsMovies": true,
    "supportsTV": true,
    "supportsAnime": true,
    "supportsDub": true,
    "supportsSub": true,
    "supportsHome": false,
    "supportsMultipleServers": true,
    "supportsDirectLinks": false,
    "supportsDownload": false,
    "supportsSkipIntro": false,
    "supportsResume": false,
    "isSequential": false,
    "sequentialDelayMs": 0
  },

  "endpoints": {
    "searchType": "HTML",
    "detailType": "HTML",
    "sourceType": "INTERNAL_API"
  },

  "extractorIds": [
    "abyss",
    "vidmoly",
    "streamruby",
    "gdmirrorbot",
    "cloudy",
    "turbovid",
    "streamup"
  ],

  "priority": 80,
  "fallbackTo": [],

  "rateLimit": {
    "maxConcurrent": 5,
    "delayBetweenMs": 0
  },

  "maintainer": {
    "github": "flex-drivee",
    "addedAt": "2026-08-20",
    "lastVerified": "2026-08-20"
  }
}
