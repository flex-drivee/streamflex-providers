{
  "$schema": "https://streamflex.dev/schemas/provider/v1.json",
  "schemaVersion": 1,
  "providerVersion": 1,
  "minimumEngineVersion": "1.0.0",

  "id": "moviebox",
  "name": "MovieBox",
  "description": "High quality API provider with fast and reliable streams.",
  "language": "en",
  "region": "GLOBAL",

  "lifecycle": "stable",
  "status": "online",

  "domains": {
    "primary": "https://api3.aoneroom.com",
    "mirrors": [
      "https://api6.aoneroom.com",
      "https://api5.aoneroom.com",
      "https://api4.aoneroom.com",
      "https://api4sg.aoneroom.com"
    ],
    "updatedAt": "2026-08-20"
  },

  "capabilities": {
    "supportsSearch": true,
    "supportsMovies": true,
    "supportsTV": true,
    "supportsAnime": false,
    "supportsDub": false,
    "supportsSub": true,
    "supportsHome": false,
    "supportsMultipleServers": true,
    "supportsDirectLinks": false,
    "supportsDownload": true,
    "supportsSkipIntro": false,
    "supportsResume": false,
    "isSequential": false,
    "sequentialDelayMs": 0
  },

  "endpoints": {
    "searchType": "API",
    "detailType": "API",
    "sourceType": "API"
  },

  "extractorIds": [
    "moviebox"
  ],

  "priority": 95,
  "fallbackTo": ["netmirror", "fourkhdhub"],

  "rateLimit": {
    "maxConcurrent": 3,
    "delayBetweenMs": 0
  },

  "maintainer": {
    "github": "flex-drivee",
    "addedAt": "2026-08-20",
    "lastVerified": "2026-08-20"
  }
