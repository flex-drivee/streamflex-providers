{
  "$schema": "https://streamflex.dev/schemas/provider/v1.json",
  "schemaVersion": 1,
  "providerVersion": 1,
  "minimumEngineVersion": "1.0.0",

  "id": "toonstream",
  "name": "ToonStream",
  "description": "Watch Free Anime Online with SUB and DUB. Daily update on new Episodes. Cartoon and Movies.",
  "language": "hi",
  "region": "IN",

  "lifecycle": "stable",
  "status": "online",

  "domains": {
    "primary": "https://toon-stream.site",
    "mirrors": [
      "https://toonstream.vip",
      "https://toonstream.one",
      "https://toonmixindia.cc"
    ],
    "search": "https://toon-stream.site/search?keyword={query}",
    "updatedAt": "2026-09-02"
  },

  "capabilities": {
    "supportsSearch": true,
    "supportsMovies": true,
    "supportsTV": true,
    "supportsAnime": true,
    "supportsDub": true,
    "supportsSub": true,
    "supportsHome": true,
    "supportsMultipleServers": true,
    "supportsDirectLinks": false,
    "supportsDownload": true,
    "supportsSkipIntro": false,
    "supportsResume": false,
    "isSequential": false,
    "sequentialDelayMs": 0
  },

  "endpoints": {
    "searchType": "HTML_PAGE",
    "detailType": "HTML_PAGE",
    "sourceType": "HTML_EMBEDDED"
  },

  "extractorIds": [
    "dood",
    "filemoon",
    "streamsb",
    "vidmoly",
    "streamruby",
    "vidhide",
    "cdnwish",
    "cloudy",
    "gdmirrorbot",
    "techinmind",
    "emturbovid",
    "zephyrflick",
    "abyass"
  ],

  "priority": 90,
  "fallbackTo": ["animedekho"],

  "rateLimit": {
    "maxConcurrent": 3,
    "delayBetweenMs": 0
  },

  "testCases": [
    {
      "title": "Naruto",
      "year": 2002,
      "tmdbId": 46260,
      "type": "tv",
      "minimumStreams": 1
    }
  ],

  "maintainer": {
    "github": "flex-drivee",
    "addedAt": "2026-09-02",
    "lastVerified": "2026-09-02"
  }
}
