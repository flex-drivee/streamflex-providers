{
  "$schema": "https://streamflex.dev/schemas/provider/v1.json",
  "schemaVersion": 1,
  "providerVersion": 1,
  "minimumEngineVersion": "1.0.0",

  "id": "ottmirror",
  "name": "OTTMirror",
  "description": "Bollywood, Hollywood dubbed and South Indian dubbed movies and series.",
  "language": "hi",
  "region": "IN",

  "lifecycle": "beta",
  "status": "unknown",

  "domains": {
    "primary": "https://ottmirror.com",
    "mirrors": [],
    "updatedAt": "2026-07-24"
  },

  "capabilities": {
    "supportsSearch": true,
    "supportsMovies": true,
    "supportsTV": true,
    "supportsAnime": false,
    "supportsDub": true,
    "supportsSub": false,
    "supportsHome": true,
    "supportsMultipleServers": true,
    "supportsDirectLinks": false,
    "supportsDownload": false,
    "supportsSkipIntro": false,
    "supportsResume": false,
    "isSequential": false,
    "sequentialDelayMs": 0
  },

  "endpoints": {
    "searchType": "HTML_PAGE",
    "detailType": "HTML_PAGE",
    "sourceType": "HTML_EMBEDDED"
  },

  "extractorIds": [
    "hubcloud",
    "pixeldrain",
    "dood",
    "streamtape",
    "hubdrive"
  ],

  "priority": 85,
  "fallbackTo": ["vegamovies", "netmirror"],

  "rateLimit": {
    "maxConcurrent": 2,
    "delayBetweenMs": 0
  },

  "testCases": [
    {
      "title": "Inception",
      "year": 2010,
      "tmdbId": 27205,
      "type": "movie",
      "minimumStreams": 1
    }
  ],

  "maintainer": {
    "github": "flex-drivee",
    "addedAt": "2026-07-24",
    "lastVerified": "2026-07-24"
  }
}
