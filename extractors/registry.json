        "hubcloud.tel",
        "hubcloud.lol",
        "hubcloud.art",
        "hubcloud.bond",
        "hubcloud.mov",
        "hubcloud.life",
        "hubcloud.bar"
      ],
      "outputFormats": ["mp4", "m3u8"],
      "requiresReferer": true,
      "headers": {
        "Referer": "https://hubcloud.tel/",
        "Origin": "https://hubcloud.tel"
      },
      "notes": "Resolves through multiple hops. Engine must follow redirects. Outputs Google Video or direct MP4.",
      "androidClass": "com.streamflex.extractors.hubcloud.HubCloudExtractor",
      "webTs": "src/lib/extractors/HubCloudExtractor.ts"
    },
